# --- General ---
APP_ENV=dev
LOG_LEVEL=INFO
API_SHARED_SECRET=            # obligatorio en producción (cabecera X-API-Key / ?key= en WS)
DEFAULT_LANGUAGE=es

# --- Visión ---
VISION_BACKEND=hybrid         # yolo | vlm | hybrid | fake
YOLO_MODEL_PATH=yolov8n.pt
YOLO_HAZARD_MODEL_PATH=       # p. ej. training/runs/hazards/weights/best.pt
YOLO_CONFIDENCE=0.35
ANTHROPIC_API_KEY=
VLM_MODEL=claude-sonnet-5-5   # claude-haiku-5-5 (barato) | claude-opus-5-5 (máxima calidad)
VLM_INTERVAL_S=4.0
CAMERA_HORIZONTAL_FOV_DEG=100

# --- Alertas ---
ALERT_COOLDOWN_S=3.0
ALERT_MIN_INTERVAL_S=1.2
ALERT_MAX_DISTANCE_M=8.0
VEHICLE_MAX_DISTANCE_M=15.0

# --- Voz (OpenAI) ---
OPENAI_API_KEY=
STT_MODEL=gpt-4o-mini-transcribe
STT_FALLBACK_MODEL=whisper-1
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=nova

# --- Navegación (Google Maps Platform: Routes API, Places API (New), Geocoding API) ---
GOOGLE_MAPS_API_KEY=

# --- Uber ---
UBER_PROVIDER=deeplink        # deeplink | api | fake
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
UBER_SERVER_TOKEN=
UBER_REDIRECT_URI=faro://uber/callback
UBER_USE_SANDBOX=true
